# RobotHub 配置示例 / RobotHub configuration example
# 本地运行: cp .env.example .env 后 docker compose up
# Local: cp .env.example .env then `docker compose up`
# 云平台(Render 等): 在面板设置同名环境变量，DB_PATH 指向持久磁盘挂载点
# Cloud (Render etc.): set these in the dashboard; point DB_PATH at the mounted disk

# 监听端口 / Listen port (云平台会注入 $PORT，本地默认 3100)
PORT=3100

# 后台管理令牌 / Admin console token (生产务必改为强随机值)
ADMIN_TOKEN=robothub-admin-2026

# SQLite 数据库路径 / DB file path
# 本地/compose 默认: ./db/robot-hub.db
# Render: /data/robot-hub.db (挂载的持久磁盘)
DB_PATH=./db/robot-hub.db
